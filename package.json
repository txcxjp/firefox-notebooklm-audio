{
  "name": "firefox-notebooklm-audio",
  "version": "1.0.0",
  "description": "Firefox extension to automatically generate and download NotebookLM Audio Overviews",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "lint": "npx web-ext lint",
    "build": "npx web-ext build --overwrite-dest"
  },
  "type": "module",
  "keywords": [
    "firefox-addon",
    "webextension",
    "notebooklm",
    "audio-overview"
  ],
  "author": "txcxjp",
  "license": "MIT",
  "webExt": {
    "ignoreFiles": [
      "tests",
      "tests/**",
      "CONVERSATION_HISTORY.md",
      "package.json",
      "package-lock.json",
      "web-ext-artifacts/**"
    ]
  }
}
